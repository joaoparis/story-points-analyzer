# ---------------------------------------------------------------------------
# Required — always needed
# ---------------------------------------------------------------------------
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_TOKEN=your-jira-personal-access-token

# ---------------------------------------------------------------------------
# Optional — narrow the Jira query scope (strongly recommended)
# ---------------------------------------------------------------------------
JIRA_PROJECT=YOUR_PROJECT_KEY
JIRA_FEATURE_TEAM=Your Feature Team Name

# ---------------------------------------------------------------------------
# Required only when using --publish (publish to Confluence)
# ---------------------------------------------------------------------------
CONFLUENCE_BASE_URL=https://your-org.atlassian.net/wiki
CONFLUENCE_TOKEN=your-confluence-personal-access-token
CONFLUENCE_PARENT_PAGE_ID=your-parent-page-id
CONFLUENCE_SPACE_KEY=YOUR_SPACE_KEY
